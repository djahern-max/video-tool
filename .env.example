# ElevenLabs credentials for scripts/generate-audio.ts. Copy to .env and fill in.
# Generating audio spends credits and is the human's step; everything else
# (render, export) needs only ELEVENLABS_VOICE_ID, which is written into each
# package manifest as tts_voice_id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
